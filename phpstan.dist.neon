parameters:
    # Every core makes a laptop unusable.
    parallel:
        maximumNumberOfProcesses: 4
    level: max
    phpVersion: 80100
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    bootstrapFiles:
        - vendor/autoload.php
    paths:
        - src/
        - tests/
    # The ODM shells are declared inside `if` (doctrine/collections 2 vs 3), where PHPStan does not read inline ignores.
    ignoreErrors:
        -
            # first()/last() return null for an empty list in every variant (spec 7.7); Doctrine's PHPDoc says false.
            identifier: method.childReturnType
            message: '#::(first|last)\(\) should be covariant with return type \(.+\|false\) of method Doctrine\\Common\\Collections\\ReadableCollection#'
            path: src/Doctrine/DoctrineCollectionBehaviour.php
        -
            # The native type must stay as wide as ODM's generated subclass declares it; only int keys are returned.
            identifier: method.childReturnType
            message: '#::(key|indexOf)\(\) should be covariant with return type#'
            path: src/Doctrine/DoctrineCollectionBehaviour.php
            # doctrine/collections 3's PHPDoc agrees with the native type: the error exists on 2 only.
            reportUnmatched: false
        -
            # Doctrine's PHPDoc has no index parameter; ours passes it only to a reducer that declares a third one.
            identifier: method.childParameterType
            message: '#::reduce\(\) should be contravariant with parameter \$func#'
            path: src/Doctrine/DoctrineCollectionBehaviour.php
        -
            # PHPStan reads the doctrine/collections 3 branch even when 2 is installed; there Collection is not Selectable.
            identifiers: [return.type, return.phpDocType, missingType.generics]
            message: '#::matching\(\)|is not subtype of native type Doctrine\\Common\\Collections\\ReadableCollection&Doctrine\\Common\\Collections\\Selectable#'
            path: src/Doctrine/DoctrineCollectionBehaviour.php
            reportUnmatched: false
    disallowedFunctionCalls:
        -
            function:
                - 'var_dump()'
                - 'print_r()'
                - 'dump()'
                - 'dd()'
            message: 'debug artefact'
        -
            function:
                - 'memory_reset_peak_usage()'
                - 'ini_parse_quantity()'
                - 'mysqli_execute_query()'
                - 'openssl_cipher_key_length()'
                - 'libxml_get_external_entity_loader()'
                - 'json_validate()'
                - 'mb_str_pad()'
                - 'str_increment()'
                - 'str_decrement()'
                - 'array_find()'
                - 'array_find_key()'
                - 'array_any()'
                - 'array_all()'
                - 'mb_trim()'
                - 'mb_ltrim()'
                - 'mb_rtrim()'
                - 'mb_ucfirst()'
                - 'mb_lcfirst()'
                - 'fpow()'
                - 'http_get_last_response_headers()'
                - 'http_clear_last_response_headers()'
                - 'request_parse_body()'
                - 'grapheme_str_split()'
                - 'bcdivmod()'
                - 'array_first()'
                - 'array_last()'
                - 'get_error_handler()'
                - 'get_exception_handler()'
            message: 'PHP 8.2+ only; 1.x runs on PHP 8.1 (phpVersion: 80100 does not catch functions present in the analysing runtime)'
    disallowedClasses:
        -
            class:
                - 'Random\Randomizer'
                - 'SensitiveParameter'
                - 'AllowDynamicProperties'
                - 'Override'
                - 'Deprecated'
                - 'DateMalformedStringException'
            message: 'PHP 8.2+ only; 1.x runs on PHP 8.1'
