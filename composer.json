{
    "name": "msstc4php/dto-collection",
    "description": "Typed lists for PHP 8.1+: immutable, mutable and Doctrine MongoDB ODM variants with natively typed element signatures.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "collection",
        "typed-collection",
        "list",
        "dto",
        "doctrine",
        "mongodb-odm"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1 <8.5"
    },
    "require-dev": {
        "doctrine/collections": "^2.1 || ^3.1",
        "doctrine/mongodb-odm": "^2.10",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "doctrine/collections": "Needed by the Doctrine ODM collection variant (MSSTC4PHP\\DtoCollection\\Doctrine)",
        "doctrine/mongodb-odm": "Lets the ODM variant be used as collectionClass of EmbedMany/ReferenceMany"
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\DtoCollection\\": "src/"
        },
        "files": [
            "src/Pipe/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\DtoCollection\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.31"
        },
        "platform-check": "php-only",
        "audit": {
            "abandoned": "report"
        }
    }
}
